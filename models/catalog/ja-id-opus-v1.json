{
  "schema": "cliplingo.model-pack/v1",
  "id": "ja-id-opus-v1",
  "source_language": "ja",
  "target_language": "id",
  "route": ["ja", "en", "id"],
  "runtime": {
    "engine": "ctranslate2",
    "version": "4.8.2",
    "device": "cpu",
    "quantization": "int8"
  },
  "build_tools": {
    "python": ">=3.10,<3.15",
    "ctranslate2": "4.8.2",
    "transformers": "5.16.1",
    "torch": "2.13.0",
    "sentencepiece": "0.2.2"
  },
  "stages": [
    {
      "id": "ja-en",
      "source_language": "ja",
      "target_language": "en",
      "model": "Helsinki-NLP/opus-mt-ja-en",
      "revision": "424876924b1a9f8a9ee4648a64581466afa072b5",
      "license": "Apache-2.0",
      "output_directory": "stages/ja-en",
      "copy_files": ["source.spm", "target.spm", "tokenizer_config.json"]
    },
    {
      "id": "en-id",
      "source_language": "en",
      "target_language": "id",
      "model": "Helsinki-NLP/opus-mt-en-id",
      "revision": "abef34fbf5248b8e1d1614695cfd4464ffd4d282",
      "license": "Apache-2.0",
      "output_directory": "stages/en-id",
      "copy_files": ["source.spm", "target.spm", "tokenizer_config.json"]
    }
  ]
}
